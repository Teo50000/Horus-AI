# Copiar este archivo como  .env  (sin el .example) y completar.
#
# EMAIL_PASSWORD NO es la clave de tu Gmail: es una "contrasena de
# aplicacion" de 16 letras que genera Google. Se saca con la verificacion
# en dos pasos activada, en:
#     https://myaccount.google.com/apppasswords
#
# El .env no se sube al repositorio (esta en .gitignore). La clave no la
# pongas en ningun otro archivo ni se la pases a nadie.

EMAIL_SENDER=el-gmail-que-manda-las-alertas@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Opcionales. Por defecto Gmail sobre SSL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_TIMEOUT=10
